# cp me to .env to root of workspace and DEFINE variables if starting new environment for first time!
# NOTE: This file is merely an example. It's unneeded to a running system.
# NOTE: Create certs to match name of domain name

# For free domain, since certbot needs registered domain,
# from domains are available with subdomains by using
# for "local development" in a cloud VM with digital ocean
# with https://freedns.afraid.org/
# otherwise, yes you will have to use mkcert, and continue with original attempt,
# modify /etc/hosts that docker desktop handles for windows, but locally for self-signed certs

# -----------------------------------------------------------------------
# Environment mode: local | production
#   local      - HTTP only, no certbot, DOMAIN_NAME=localhost (or custom)
#   production - HTTPS via Let's Encrypt; also pass --profile ssl to compose
# -----------------------------------------------------------------------
ENVIRONMENT=local

# Set to "true" to activate SSL (Let's Encrypt / certbot).
# When true, also run:  docker compose --profile ssl up -d
ENABLE_SSL=false

# Set to "true" to include www.$DOMAIN_NAME in the nginx server_name.
# Only relevant when ENABLE_SSL=true.
ENABLE_WWW=false

# For local dev use: localhost   For production use your registered domain.
DOMAIN_NAME=localhost

# Your real registered public domain (e.g. mysite.com).
# Used by certbot and nginx when ENABLE_SSL=true.
# Keep DOMAIN_NAME=localhost for local dev; wporchestrator enable-ssl-after-first-time-bring-up
# will automatically swap DOMAIN_NAME → PRODUCTION_DOMAIN in .env when activating SSL.
PRODUCTION_DOMAIN=

CONTAINER_NAME=

DATABASE_NAME=
DATABASE_PORT=3306
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_ROOT_PASSWORD=

WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_PASSWORD=

WORDPRESS_ADMIN_EMAIL=

# Only needed when ENABLE_SSL=true. Remove --staging for a real cert.
CERTBOT_STAGING_FLAG=--staging

# Table prefix used in the DB. Set to match production if restoring from backup.
WORDPRESS_TABLE_PREFIX=wp_
