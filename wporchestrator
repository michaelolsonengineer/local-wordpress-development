# set -e: Exit on error
# set -u: Throw error if undefined variable used
set -e -u

# shellcheck disable=SC2155
declare -xg SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/tools/common/constants.sh"
source "${SCRIPT_DIR}/tools/common/general_utils.sh"
# NOTE: WORKSPACE=$SCRIPT_DIR

#------------------------------------------------------------------------------

# __script_help
#       Called by the help script, this function should print out a help
#       message instructing the user on the usage of the script and return
#       cleanly.  This function can include programmatic generation of the help
#       text, but it cannot rely on any of its fellow __script functions to
#       have been called in the current context
__script_help() { # Required
  cat <<EOM
===== $0 ====

# Description:
    The main runner docker wordpress compose server

# How to Use:
    $0 <...>

# Inputs:
    commands:
        install_dependencies:
            This flag is used to indicate that the script should install the necessary dependencies for the server to run
            properly. This will create a file to indicate the dependencies are installed and avoid running the steps in this
            function again in the future.

        first-time-bring-up:
            Docker bring with certbot requires proper interaction between the machines since their the SSL certs in this setup, get
            downloaded and then are installed. This makes for a smaller form  factor and less overhead. This flag is used to
            indicate that this is the first time the server is being brought up and the script should run the necessary steps to
            bring up the server properly. This will create a file to indicate the first time bring up is complete and avoid running
            the steps in this function again in the future.
            NOTE: This flag will also run the install_dependencies flag.

        enable-ssl-after-first-time-bring-up:
            This flag is used to indicate that the server has already been brought up and the script should run the necessary steps
            to enable SSL on the server. This will create a file to indicate the SSL is enabled complete and avoid running
            the steps in this function again in the future.
        wp-setup:
            This flag is used to indicate that the script should run the necessary steps to setup the Wordpress server. This will
            create a file to indicate the Wordpress server is setup complete and avoid running the steps in this function again in
            the future.
        restore-from-backup <backup-dir-or-file>:
            Restore a WordPress site from an UpdraftPlus backup set. Pass either a directory containing
            the backup files (*.db.gz, *.plugins.zip, etc.) or a single backup file. The script will
            copy files into the container, trigger UpdraftPlus to rescan, run the restore via WP-CLI,
            then fix siteurl/home to point to localhost.
        fix-urls:
            Reset WordPress siteurl and home options to http://localhost.
            Run this after an UpdraftPlus restore to avoid being redirected to the production domain.
        logs:
            Print the logs from all containers created in docker-compose.yml
        nuke:
            nuke. Don't use this unless you are sure
    args:

# Side Effects
    None
EOM

  exit 1
}

# __script_parse_opts "${_script_opts}" (optional)
#       Parse the options passed to execute_script.  This function can store
#       values passed in via flags as global variables to be consumed by later
#       stages. (see `declare -g` for setting global variables in a function)
#       Note: arguments are not subsequently passed to __script_exec
__script_parse_opts() { # Optional
  echo "Parsing options for $0 ..."

  # Set default values
  declare -xg _do_first_time_bring_up_flag="false"
  declare -xg _do_enable_ssl_after_first_time_bring_up_flag="false"
  declare -xg force="false"

  # Parse options
  while (($#)); do
    case "${1}" in
    --force)
      force="true"
      ;;
    install_dependencies)
      info "Running install_dependencies ..."
      install_dependencies --developer-tools
      exit 0
      ;;
    logs)
      info "Running docker compose logs ..."
      docker_compose_logs
      exit 0
      ;;
    first-time-bring-up)
      _do_first_time_bring_up_flag="true"
      ;;
    enable-ssl-after-first-time-bring-up)
      _do_first_time_bring_up_flag="true"
      _do_enable_ssl_after_first_time_bring_up_flag="true"
      ;;
    wp-setup)
      info "Running wp-setup ..."
      bash "${WORKSPACE}/admin/webserver/wp_setup.sh" --env-file "${WORKSPACE}/.env"
      exit 0
      ;;
    restore-from-backup)
      shift
      if [ -z "${1:-}" ]; then
        error "Usage: $0 restore-from-backup <backup-dir-or-file>"
        exit 1
      fi
      restore_from_backup "${1}"
      exit 0
      ;;
    fix-urls)
      bash "${WORKSPACE}/admin/webserver/restore_from_backup.sh" --env-file "${WS_ENV_FILE}" --fix-urls
      exit 0
      ;;
    nuke)
      source "${WORKSPACE}/admin/webserver/nuke.sh"
      __nuke
      exit 1
      ;;
    -h | --help | help)
      __script_help
      exit
      ;;
    *)
      echo "Unknown argument: $1"
      echo "call script with -h or --help to list available arguments"
      exit 1
      ;;
    esac
    shift
  done

  info "---------------------------------------------------------------------"
  info "first_time_bring_up_flag:                       ${_do_first_time_bring_up_flag}"
  info "enable_ssl_after_first_time_bring_up_flag:      ${_do_enable_ssl_after_first_time_bring_up_flag}"
  info "---------------------------------------------------------------------"
}

# __script_init (optional)
#       Initialize and validate the scripts environment.  This stage runs after
#       __script_parse_opts, so global variables set by parse_opts will be
#       available here.
#       This stage is useful for ensuring build tools are present, and ensuring
#       the necessary environment variables are set.
__script_init() { # Optional
  if [ "${_do_first_time_bring_up_flag}" = "true" ]; then
    if [ "${force}" = "true" ]; then
      info "Force running first_time_bring_up..."
      rm -rf "${WORKSPACE}/.first_time_bring_up_complete"
    fi
  fi

  if [ "${_do_enable_ssl_after_first_time_bring_up_flag}" = "true" ]; then
    if [ "${force}" = "true" ]; then
      info "Force running enable_ssl_after_first_time_bring_up..."
      rm -rf "${WORKSPACE}/.enable_ssl_after_first_time_bring_up_complete"
    fi
  fi
}

# __script_exec
#       Execute the script! This function receives no arguments and it assumes
#       the environment is fully configured before entering __script_exec. This
#       architecture enforces good script writing practices and reduces script
#       boilerplate for error handling.
__script_exec() { # Required
  if [ "${_do_first_time_bring_up_flag}" = "true" ]; then
    info "Running first_time_bring_up ..."
    first_time_bring_up
  fi

  if [ "${_do_enable_ssl_after_first_time_bring_up_flag}" = "true" ]; then
    info "Running enable_ssl_after_first_time_bring_up ..."
    enable_ssl_after_first_time_bring_up
  fi

  # NOTE: This is where you would add any other functions to run
}

# __script_succeed (optional)
#       If __script_exec succeeds, __script_succeed is evaluated.  This can be
#       used to provide feedback to the user about the success, or trigger
#       post-script-success logic
__script_succeed() { # Optional
  ok "$0 succeeded!!!"
}

# __script_failed (optional)
#       If __script_exec fails, __script_failed is evaluated.  This can be used
#       to provide feedback to the user about the failure and trigger
#       post-script-failed logic.
__script_failed() { # Optional
  error "$0 failed (aka the nonstandard-exit method)!!!"

  # docker container list
  # docker volume list
  # docker compose down
  # docker volume rm \
  #   "${SCRIPT_DIR%/*}_wordpress_volume" \
  #   "${SCRIPT_DIR%/*}_dbdata_volume" \
  #   "${SCRIPT_DIR%/*}_certbot-etc_volume"
  # sudo rm -rf src/
}

# __script_cleanup
#       __script_cleanup is run as the very last step of
#       execute script, after __script_succeed/__script_failed.  This can be
#       leveraged to perform any necessary cleanup regardless of the scripts
#       exit status
__script_cleanup() {
  if [ $? -eq 0 ]; then
    __script_succeed
  else
    __script_failed
  fi

  # Optional
  # info "Cleaning up potential dirty state ..."
}

# install_dependencies
#       This function will install the necessary dependencies for the to be installed server to run properly.
#       The function is designed to only install the individual dependencies if it detects if the particular
#       dependencies are not installed/missing.
install_dependencies() {
  info "Checking/Installing dependencies ..."
  local options=$@
  source "${SCRIPT_DIR}/tools/common/dependencies.sh"
  install_basic_packages
  install_webapp_packages
  setup_docker
  if is_item_in_list $options "--developer-tools"; then
    install_developer_tools_packages
  fi
}

# first_time_bring_up
#       This function will bring up the server for the first time. It will create the necessary files and directories
#       for the server to run properly. It will also create the necessary docker containers and volumes for the server
#       to run properly. This function will also create a file to indicate the first time bring up is complete and avoid
#       running this function again in the future.
first_time_bring_up() {
  info "First time bring up"

  if [ -e "${WORKSPACE}/.first_time_bring_up_complete" ]; then
    warning "Detected server first time bring up process completed, don't need to run this process again"
    return
  fi

  # pull in the variables from the .env file
  . "${WS_ENV_FILE}"

  # info "Disable local MySQL instances to perform next tasks (if any installed via apt-get)?"
  # if confirm; then
  sudo systemctl stop mysql &>/dev/null || true
  sudo systemctl disable mysql &>/dev/null || true
  # fi

  # Ensure the necessary dependencies are installed
  install_dependencies

  docker compose up -d

  # Wait for WordPress container to finish its own init (copies files, generates wp-config.php).
  # Docker healthcheck already ensured the DB is ready before wordpress started;
  # we just need to wait for the wordpress entrypoint to finish writing wp-config.php.
  info "Waiting for WordPress container to finish initialization (wp-config.php) ..."
  local wp_timeout=180
  local wp_elapsed=0
  while ! docker compose exec -T wordpress test -f /var/www/html/wp-config.php 2>/dev/null; do
    if [ ${wp_elapsed} -ge ${wp_timeout} ]; then
      error "Timed out waiting for WordPress to initialize after ${wp_timeout}s. Check: docker compose logs wordpress"
      exit 1
    fi
    printf .
    sleep 3
    wp_elapsed=$((wp_elapsed + 3))
  done
  echo  # newline after dots

  docker compose ps

  # Check if wordpress files were created
  [ -e "${WORKSPACE}/src" ] ||
    error "WordPress src bind-mount not found — did the volume fail to populate?"
  info "All containers up. Run './wporchestrator logs' to inspect individual container output."

  info "Running WordPress setup ..."
  bash "${WORKSPACE}/admin/webserver/wp_setup.sh" --env-file "${WORKSPACE}/.env"

  # Create a file to indicate first time bring up is complete and avoid
  # running this function again
  touch "${WORKSPACE}"/.first_time_bring_up_complete
  info "First time bring up complete"
}

# enable_ssl_after_first_time_bring_up
#       This function will enable SSL on the server after the server has been brought up for the first time. It will
#       create the necessary files and directories for the server to run properly. It will also create the necessary
#       docker containers and volumes for the server to run properly. This function will also create a file to indicate
#       the SSL is enabled complete and avoid running this function again in the future.
# shellcheck disable=SC2120
enable_ssl_after_first_time_bring_up() {
  local WEB_SERVICE_NAME="${1:-webserver}"
  local CERT_SERVICE_NAME="${2:-certbot}"
  info "Add and Enable SSL in ${WEB_SERVICE_NAME} in configuration"

  if [ ! -e "${SCRIPT_DIR}/.first_time_bring_up_complete" ]; then
    warn "Webserver needs to have successfully started first time bring up process to run this process."
    return
  fi

  if [ -e "${SCRIPT_DIR}/.enable_ssl_after_first_time_bring_up_complete" ]; then
    warn "Detected SSL webserver configuration process completed, don't need to run this process again."
    return
  fi

  # pull in the variables from the .env file
  . "${WS_ENV_FILE}"

  # Validate that PRODUCTION_DOMAIN is set before touching anything
  if [ -z "${PRODUCTION_DOMAIN:-}" ]; then
    error "PRODUCTION_DOMAIN is not set in ${WS_ENV_FILE}. Set it to your registered public domain and retry."
    exit 1
  fi

  info "Switching DOMAIN_NAME → PRODUCTION_DOMAIN (${PRODUCTION_DOMAIN}) in .env ..."
  sed -i "s|^DOMAIN_NAME=.*|DOMAIN_NAME=${PRODUCTION_DOMAIN}|" "${WS_ENV_FILE}"

  info "Enabling SSL and clearing staging flag in .env ..."
  sed -i 's|^ENABLE_SSL=.*|ENABLE_SSL=true|' "${WS_ENV_FILE}"
  sed -i 's|^CERTBOT_STAGING_FLAG=.*|CERTBOT_STAGING_FLAG=|' "${WS_ENV_FILE}"

  # Reload vars now that .env has been updated
  . "${WS_ENV_FILE}"

  info "Obtaining production certificates via certbot (--profile ssl) ..."
  docker compose --profile ssl up --force-recreate --no-deps "${CERT_SERVICE_NAME}"

  info "Checking certificates were issued for ${DOMAIN_NAME} ..."
  docker compose exec "${WEB_SERVICE_NAME}" ls -la /etc/letsencrypt/live/"${DOMAIN_NAME}" || \
    error "Certificates not found — certbot may have failed. Check: docker compose --profile ssl logs ${CERT_SERVICE_NAME}"

  info "Stopping the service(${WEB_SERVICE_NAME}) to pick up new ENABLE_SSL=true + domain ..."
  docker compose stop "${WEB_SERVICE_NAME}"

  info "Recreating the service(${WEB_SERVICE_NAME}) with SSL configuration ..."
  docker compose up -d --force-recreate --no-deps "${WEB_SERVICE_NAME}"

  info "Updating WordPress siteurl and home to https://${DOMAIN_NAME} ..."
  local wp_cli="docker compose run --rm wordpress-cli wp"
  ${wp_cli} option update siteurl "https://${DOMAIN_NAME}" --allow-root --path="${WEBSERVER_ROOT}" ||
    error "Failed to update siteurl in WordPress DB to https://${DOMAIN_NAME}"
  ${wp_cli} option update home "https://${DOMAIN_NAME}" --allow-root --path="${WEBSERVER_ROOT}" ||
    error "Failed to update home in WordPress DB to https://${DOMAIN_NAME}"
  info "WordPress URLs updated to https://${DOMAIN_NAME}"

  info "${CONTAINER_NAME}-${CERT_SERVICE_NAME}: \"docker compose logs ${CERT_SERVICE_NAME}\""
  docker compose logs "${CERT_SERVICE_NAME}"

  info "${CONTAINER_NAME}-${WEB_SERVICE_NAME}: \"docker compose logs ${WEB_SERVICE_NAME}\""
  docker compose logs "${WEB_SERVICE_NAME}"

  # Create a file to indicate first time bring up is complete and avoid to rerunning this function again
  touch "${SCRIPT_DIR}"/.enable_ssl_after_first_time_bring_up_complete
  info "SSL enabled in ${WEB_SERVICE_NAME} complete"
}

# restore_from_backup <backup-path>
#       Delegates to admin/webserver/restore_from_backup.sh — see that file for full details.
restore_from_backup() {
  local backup_path="${1}"
  bash "${WORKSPACE}/admin/webserver/restore_from_backup.sh" --env-file "${WS_ENV_FILE}" "${backup_path}"
}

# fix_urls
#       Delegates to admin/webserver/restore_from_backup.sh --fix-urls
fix_urls() {
  bash "${WORKSPACE}/admin/webserver/restore_from_backup.sh" --env-file "${WS_ENV_FILE}" --fix-urls
}

docker_compose_logs() {
  info "Getting logs from all containers created in docker-compose.yml..."
  . "${WS_ENV_FILE}"
  local compose_service
  for compose_service in $(yq '.services | keys[]' docker-compose.yml); do
    compose_service=${compose_service//\"/}
    local named_service=${CONTAINER_NAME}-${compose_service}
    info "${named_service}: \"docker compose logs ${compose_service}\""
    docker compose logs "${compose_service}"
  done
}

# ===== Main Script Workflow =====
trap __script_cleanup EXIT

__script_parse_opts "${@}"
__script_init
__script_exec
